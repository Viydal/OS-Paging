{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug memsim",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/memsim",
            "args": [
                "traces/realTraces/bzip.trace",
                "8",
                "lru",
                "debug"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "lldb",
            "MIDebuggerPath": "/usr/bin/lldb"
        }
    ]
}
